<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.YikatongDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.YikatongEntity" id="yikatongMap">
        <result property="yezhuzhanghao" column="yezhuzhanghao"/>
        <result property="yezhuxingming" column="yezhuxingming"/>
        <result property="loudonghao" column="loudonghao"/>
        <result property="loufanghao" column="loufanghao"/>
        <result property="kahao" column="kahao"/>
        <result property="shuliang" column="shuliang"/>
        <result property="quanxianxinxi" column="quanxianxinxi"/>
        <result property="beizhu" column="beizhu"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.YikatongView" >

		SELECT  yikatong.* FROM yikatong  yikatong 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.YikatongView" >
		SELECT * FROM yikatong  yikatong <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
